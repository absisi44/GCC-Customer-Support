# ==============================================================================
# GCC Customer Support AI — Environment Variables Template
# Copy this to .env for local development or set in Railway Dashboard -> Variables
# ==============================================================================

# --- LLM API Keys (Set at least OpenAI or your primary model provider) ---
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
HUGGING_FACE_KEY=your_huggingface_key_here
LANGCHAIN_API_KEY=your_langchain_api_key_here

# --- LangGraph State Persistence (Railway PostgreSQL Plugin) ---
# Automatically provided when you attach the PostgreSQL plugin in Railway.
# If omitted or unavailable, the system automatically falls back to in-memory state.
DATABASE_URL=postgresql://postgres:password@localhost:5432/customer_support

# --- Vector Database & Storage ---
CHROMA_PERSIST_DIRECTORY=/app/chroma_db

# --- Server Port (Injected automatically by Railway) ---
PORT=8000
